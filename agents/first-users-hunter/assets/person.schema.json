{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "first-users-hunter person row",
  "description": "One line of <project>/first-users-hunter/people-<YYYYMMDD>.jsonl: one person with a dated signal, proven active, with the fit reason and the first two touches. The model writes it from shortlist.jsonl after reading the signal thread; verify_people.py checks it (schema, excerpt in the cached page, signal age, post-id date and owner, activity recomputed, touch limits); export_handoff.py turns it into the cold-outreach-builder handoff. Only professional data the person published, one source URL per fact.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "person_id", "person_key", "name", "first_name", "profile_url", "networks", "language", "signal", "activity", "fit", "score", "score_breakdown", "first_touch", "status"],
  "properties": {
    "schema_version": { "const": "2.0" },
    "person_id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9_-]{0,40}$", "description": "Stable id in the file (p001...). Becomes prospect_id for cold-outreach-builder." },
    "person_key": { "type": "string", "pattern": "^[a-z_]+:.+$", "description": "Key of shortlist.jsonl, <network>:<handle>." },
    "name": { "type": "string", "minLength": 1, "description": "Display name as the person shows it publicly (a handle when no name is published)." },
    "first_name": { "type": "string", "minLength": 1, "description": "First name when published, else the handle: messages greet the way the person signs." },
    "last_name": { "type": "string" },
    "role": { "type": "string" },
    "company": { "type": "string" },
    "company_url": { "type": "string" },
    "profile_url": { "type": "string", "pattern": "^https?://" },
    "linkedin_url": { "type": "string" },
    "email": { "type": "string", "description": "Only an address the person published for professional contact, on email_source_url. Never guessed, never checked by SMTP." },
    "email_source_url": { "type": "string" },
    "networks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["network", "handle"],
        "properties": {
          "network": { "type": "string", "enum": ["hn", "github", "reddit", "luma", "linkedin", "x", "web", "community"] },
          "handle": { "type": "string", "minLength": 1 },
          "url": { "type": "string" }
        }
      }
    },
    "language": { "type": "string", "pattern": "^[a-z]{2}$", "description": "Language the person writes in publicly; the touches use it." },
    "geography": { "type": "string", "pattern": "^([a-z]{2})?$" },
    "signal": {
      "type": "object",
      "additionalProperties": false,
      "required": ["signal_id", "type", "url", "date", "date_source", "excerpt", "network"],
      "properties": {
        "signal_id": { "type": "string" },
        "type": { "type": "string", "enum": ["ask", "switch", "complaint", "question", "trigger", "event", "build"] },
        "url": { "type": "string", "pattern": "^https?://" },
        "thread_url": { "type": "string" },
        "date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
        "date_source": { "type": "string", "enum": ["api", "post_id", "page", "registry", "founder"] },
        "excerpt": { "type": "string", "minLength": 15, "maxLength": 400, "description": "Verbatim words copied from the cached page of url, original language." },
        "network": { "type": "string" },
        "community": { "type": "string" }
      }
    },
    "activity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "weighted_posts", "window_days", "last_active_at", "evidence_urls"],
      "properties": {
        "status": { "type": "string", "enum": ["active", "not_proven", "dead_handle"] },
        "weighted_posts": { "type": "number", "minimum": 0 },
        "window_days": { "type": "integer", "minimum": 1 },
        "last_active_at": { "type": "string", "pattern": "^(\\d{4}-\\d{2}-\\d{2})?$" },
        "active_networks": { "type": "array", "items": { "type": "string" } },
        "evidence_urls": { "type": "array", "items": { "type": "string", "pattern": "^https?://" } }
      }
    },
    "fit": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reason", "source_url"],
      "properties": {
        "reason": { "type": "string", "minLength": 20, "maxLength": 300, "description": "One sentence: why this person fits the target user, in the researcher's words." },
        "source_url": { "type": "string", "pattern": "^https?://" },
        "excerpt": { "type": "string", "maxLength": 400, "description": "Optional verbatim words of source_url that support the reason; checked against the cache when present." }
      }
    },
    "score": { "type": "number" },
    "score_breakdown": { "type": "object" },
    "first_touch": { "$ref": "#/$defs/touch" },
    "second_touch": { "$ref": "#/$defs/touch" },
    "pages_read": { "type": "array", "items": { "type": "string", "pattern": "^https?://" }, "description": "Every URL read for this person (the full thread included), each cached." },
    "status": { "type": "string", "enum": ["new"] },
    "notes": { "type": "string" }
  },
  "$defs": {
    "touch": {
      "type": "object",
      "additionalProperties": false,
      "required": ["channel", "text"],
      "properties": {
        "channel": { "type": "string", "enum": ["reply_in_thread", "dm", "connection_note", "email", "event_intro"] },
        "network": { "type": "string", "description": "Where the touch is sent (hn, x, linkedin, github, reddit, email, event)." },
        "text": { "type": "string", "minLength": 20 }
      }
    }
  }
}
