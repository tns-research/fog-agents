---
import Base from "../layouts/Base.astro";
import ApplyForm from "../components/ApplyForm.astro";
---
<Base title="Apply to Northdock (test fixture)">
  <div class="wrap">
    <header>
      <a class="logo" href="/">Northdock</a>
    </header>
    <h1 style="font-size:32px;margin:16px 0 8px">Apply to Northdock</h1>
    <p style="margin:0 0 24px;color:#c0c1c6">Tell us who you are and what you are building. The team reads every application.</p>
    <ApplyForm />
  </div>
</Base>
