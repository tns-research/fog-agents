<form class="apply" id="apply" novalidate>
  <div>
    <label for="name">Full name</label>
    <input id="name" name="name" type="text" autocomplete="name" required>
  </div>
  <div>
    <label for="email">Email</label>
    <input id="email" name="email" type="text" required>
  </div>
  <div>
    <input id="phone" name="phone" type="text" placeholder="Phone">
  </div>
  <div>
    <label for="startup">Startup name</label>
    <input id="startup" name="startup" type="text">
  </div>
  <div>
    <label for="building">What are you building?</label>
    <textarea id="building" name="building" rows="3"></textarea>
  </div>
  <div id="status"></div>
  <button type="submit" id="send">Send application</button>
</form>
