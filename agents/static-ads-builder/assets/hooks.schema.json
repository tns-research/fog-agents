{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/tns-research/fog-agents/agents/static-ads-builder/assets/hooks.schema.json",
  "title": "static-ads-builder hooks.json (mode winning_recipe)",
  "description": "The new material the model writes for a recipe: N new hooks in the recipe's hook type, each with the claims behind it (shared claims policy: a number or a fact comes from positioning.proof[N] or a source URL), and optional alternates for the other variables. scripts/recipe_variants.py build spends the alternates first, one variant each, then fills the batch with hooks.",
  "type": "object",
  "required": ["schema_version", "hooks"],
  "additionalProperties": false,
  "properties": {
    "schema_version": { "const": "1.0" },
    "sources": {
      "type": "array",
      "description": "New sources the hook claims cite, same shape as ads.json sources[]. Merged with the control run's sources.",
      "items": {
        "type": "object",
        "required": ["id", "label", "url"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9_-]*$" },
          "label": { "type": "string", "minLength": 1, "maxLength": 40 },
          "url": { "type": "string", "pattern": "^https?://" },
          "title": { "type": "string" },
          "accessed": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" }
        }
      }
    },
    "hooks": {
      "type": "array",
      "minItems": 1,
      "maxItems": 10,
      "items": {
        "type": "object",
        "required": ["text"],
        "additionalProperties": false,
        "properties": {
          "text": { "type": "string", "minLength": 1, "description": "The new headline. *word* marks the emphasis, as in ads.json." },
          "claims": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["text", "source"],
              "additionalProperties": false,
              "properties": {
                "text": { "type": "string", "minLength": 1 },
                "source": { "type": "string", "minLength": 1 },
                "verified_at": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" }
              }
            }
          },
          "why": { "type": "string", "description": "What the hook tests against the control headline." }
        }
      }
    },
    "alternates": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "cta": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["on_ad"],
            "additionalProperties": false,
            "properties": {
              "on_ad": { "type": "string", "minLength": 1, "maxLength": 32 },
              "meta": { "type": "string" }
            }
          }
        },
        "visual": { "type": "array", "items": { "type": "object" }, "description": "Each an ads.json media object (a real photo, an edited photo from photo_edit, a packshot). Only for a control that has media." },
        "surface": { "type": "array", "items": { "type": "string", "enum": ["brand", "light", "accent"] } },
        "subhead": { "type": "array", "items": { "type": "string", "minLength": 1 } }
      }
    }
  }
}
