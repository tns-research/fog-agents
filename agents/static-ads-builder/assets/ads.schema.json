{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/tns-research/fog-agents/agents/static-ads-builder/assets/ads.schema.json",
  "title": "static-ads-builder ads.json",
  "description": "The spec the model writes. scripts/build.py turns it into HTML, scripts/render.py into exact PNGs, scripts/package_meta.py into the Meta import package. Every visible word of every ad comes from this file (copy, proof, source labels, media visible_text, brand logo_text).",
  "type": "object",
  "required": ["schema_version", "meta", "ads"],
  "additionalProperties": false,
  "properties": {
    "schema_version": { "const": "1.0" },
    "meta": {
      "type": "object",
      "required": ["project", "language", "date"],
      "additionalProperties": false,
      "properties": {
        "project": { "type": "string", "minLength": 1, "pattern": "^[a-z0-9][a-z0-9-]*$", "description": "Project slug, first token of every ad name." },
        "brand": { "type": "string", "description": "Path to brand.json, relative to ads.json. Default: ../project-context/brand.json." },
        "language": { "type": "string", "enum": ["en", "fr"] },
        "date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
        "campaign": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$", "description": "Campaign slug, used in the import CSV and utm_campaign." },
        "utm": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "source": { "type": "string" },
            "medium": { "type": "string" },
            "campaign": { "type": "string" }
          }
        },
        "input": { "type": "string", "description": "Path of the next-batch input (perf.py output) this batch was planned from, when there was one." }
      }
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "label", "url"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9_-]*$" },
          "label": { "type": "string", "minLength": 1, "maxLength": 40, "description": "Short display label, rendered as 'Source: <label>' when a proof shows its source." },
          "url": { "type": "string", "pattern": "^https?://" },
          "title": { "type": "string" },
          "accessed": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" }
        }
      }
    },
    "ads": {
      "type": "array",
      "minItems": 1,
      "maxItems": 18,
      "items": { "$ref": "#/$defs/ad" }
    }
  },
  "$defs": {
    "text": { "type": "string", "minLength": 1 },
    "claim": {
      "type": "object",
      "required": ["text", "source"],
      "additionalProperties": false,
      "properties": {
        "text": { "type": "string", "minLength": 1, "description": "The claim as written on the ad or in the ad text (a number must appear here verbatim)." },
        "source": { "type": "string", "minLength": 1, "description": "A sources[].id, or positioning.proof[N] from project-context/context.json." },
        "verified_at": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" }
      }
    },
    "item": {
      "oneOf": [
        { "type": "string", "minLength": 1 },
        {
          "type": "object",
          "required": ["text"],
          "additionalProperties": false,
          "properties": {
            "label": { "type": "string", "minLength": 1, "maxLength": 24 },
            "text": { "type": "string", "minLength": 1 }
          }
        }
      ]
    },
    "column": {
      "type": "object",
      "required": ["label", "items"],
      "additionalProperties": false,
      "properties": {
        "label": { "type": "string", "minLength": 1, "maxLength": 32 },
        "items": { "type": "array", "minItems": 1, "maxItems": 5, "items": { "type": "string", "minLength": 1 } }
      }
    },
    "media": {
      "type": "object",
      "required": ["role"],
      "additionalProperties": false,
      "properties": {
        "role": { "type": "string", "enum": ["photo", "product", "screenshot", "plate"], "description": "photo: a real photo the founder supplied. product: a packshot (transparent PNG preferred). screenshot: product UI. plate: a text-free background made by an image model behind the spend gates (scripts/plates.py)." },
        "src": { "type": "string", "minLength": 1, "description": "Path relative to ads.json. For a plate not generated yet, the expected path (plates/NN-<id>.jpg)." },
        "alt": { "type": "string" },
        "fit": { "type": "string", "enum": ["contain", "cover"], "description": "contain (default): the media is shown whole, never cropped. cover: only for plates and backgrounds made for the ad." },
        "visible_text": { "type": "array", "items": { "type": "string", "minLength": 1 }, "description": "Every word printed on the media itself (product label, packaging, sign, shirt, UI), copied from the real object. The proofread diff expects these words on the render." },
        "prompt": { "type": "string", "description": "Plates only: the scene to generate, English, no text, no letters, no logo, no product." },
        "edit": {
          "type": "object",
          "required": ["spec", "photo", "concept"],
          "additionalProperties": false,
          "properties": {
            "spec": { "type": "string", "minLength": 1, "description": "photo-edits.json the edited photo came from, relative to ads.json." },
            "photo": { "type": "string", "minLength": 1, "description": "photos[].id of the source photo." },
            "concept": { "type": "string", "minLength": 1, "description": "concepts[].id rendered by scripts/photo_edit.py." },
            "person_slugs": { "type": "array", "items": { "type": "string", "minLength": 1 }, "description": "people.json slugs shown, each cleared for the ads scope." }
          },
          "description": "Provenance of a real photo edited by scripts/photo_edit.py (mode photo_edit). Role stays photo; the text is still set by the HTML."
        }
      }
    },
    "meta_ad": {
      "type": "object",
      "required": ["primary_text", "headline", "cta", "destination_url"],
      "additionalProperties": false,
      "properties": {
        "primary_text": { "type": "string", "minLength": 1, "description": "Text above the creative in the feed." },
        "headline": { "type": "string", "minLength": 1, "maxLength": 80, "description": "Link headline under the creative." },
        "description": { "type": "string", "maxLength": 120 },
        "cta": { "type": "string", "description": "Meta call-to-action button type, for example LEARN_MORE, SIGN_UP, APPLY_NOW, SHOP_NOW." },
        "destination_url": { "type": "string", "pattern": "^https?://" },
        "ad_set": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$", "description": "Ad set slug the ad goes into (exports/<ad_set>/)." },
        "end_date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$", "description": "Last day an offer or a dated message is true. Required when the copy is dated." }
      }
    },
    "ad": {
      "type": "object",
      "required": ["id", "stage", "angle", "style", "formats", "copy"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{1,40}$", "description": "Stable slug of the concept." },
        "n": { "type": "integer", "minimum": 1, "maximum": 99 },
        "stage": { "type": "string", "enum": ["tofu", "mofu", "bofu"] },
        "angle": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$", "description": "Angle slug from assets/ad-library.md section 1, for example wrong-answer, process-reveal, easy-first-step." },
        "style": {
          "type": "string",
          "enum": ["ugc-text-overlay", "meme-static", "testimonial-screenshot", "before-after-asymmetric", "ingredient-origin-strip", "cost-reframe-card", "hybrid-2d-3d-fusion", "three-benefits-card", "us-vs-them-comparison", "crossed-out-problems", "social-proof-card", "feature-callout-arrows", "myth-vs-fact", "reply-to-comment", "bold-statement", "mini-landing-page", "benefit-timeline", "flowchart-decision"]
        },
        "formats": {
          "type": "array",
          "minItems": 1,
          "maxItems": 3,
          "items": { "type": "string", "enum": ["1:1", "4:5", "9:16"] }
        },
        "surface": { "type": "string", "enum": ["brand", "light", "accent"], "description": "Base surface. brand: the brand background (bg + text). light: a light paper with the brand ink. accent: the accent colour." },
        "persuasion_principle": { "type": "string" },
        "extends": {
          "type": "object",
          "required": ["ad_name", "why"],
          "additionalProperties": false,
          "properties": {
            "ad_name": { "type": "string" },
            "why": { "type": "string", "description": "The metric that made it a winner, as read in the perf file (for example 'CPA 18.20 EUR, best of the account over 2026-09-01..30')." }
          }
        },
        "copy": {
          "type": "object",
          "required": ["headline"],
          "additionalProperties": false,
          "properties": {
            "badge": { "type": "string", "maxLength": 32, "description": "Small kicker above the headline." },
            "headline": { "$ref": "#/$defs/text" },
            "subhead": { "type": "string" },
            "bullets": { "type": "array", "maxItems": 5, "items": { "$ref": "#/$defs/item" }, "description": "three-benefits-card, crossed-out-problems, mini-landing-page, benefit-timeline (label = time step), flowchart-decision (label = branch)." },
            "columns": {
              "type": "object",
              "required": ["them", "us"],
              "additionalProperties": false,
              "properties": {
                "them": { "$ref": "#/$defs/column" },
                "us": { "$ref": "#/$defs/column" }
              },
              "description": "us-vs-them-comparison, myth-vs-fact (them = myth), before-after-asymmetric (them = before), cost-reframe-card (items[0] = the figure)."
            },
            "comment": {
              "type": "object",
              "required": ["author", "text", "reply"],
              "additionalProperties": false,
              "properties": {
                "author": { "type": "string", "minLength": 1 },
                "text": { "type": "string", "minLength": 1 },
                "reply": { "type": "string", "minLength": 1 },
                "source": { "type": "string", "description": "Where the real comment was posted (sources[].id or URL). A comment is never invented." }
              }
            },
            "callouts": {
              "type": "array",
              "maxItems": 4,
              "items": {
                "type": "object",
                "required": ["text", "x", "y"],
                "additionalProperties": false,
                "properties": {
                  "text": { "type": "string", "minLength": 1 },
                  "x": { "type": "number", "minimum": 0, "maximum": 100, "description": "Anchor on the media, % of its width." },
                  "y": { "type": "number", "minimum": 0, "maximum": 100, "description": "Anchor on the media, % of its height." }
                }
              }
            },
            "cta": { "type": "string", "maxLength": 32, "description": "Button text on the creative." }
          }
        },
        "proof": {
          "type": "object",
          "required": ["text", "source"],
          "additionalProperties": false,
          "properties": {
            "text": { "type": "string", "minLength": 1 },
            "source": { "type": "string", "minLength": 1, "description": "sources[].id or positioning.proof[N]." },
            "attribution": { "type": "string", "description": "Who said it, for a quote or a review." },
            "show_source": { "type": "boolean", "description": "Render 'Source: <label>' under the proof (default true for a sources[] id)." },
            "rating": { "type": "integer", "minimum": 1, "maximum": 5, "description": "Stars drawn as icons, only when the review itself has this rating." }
          }
        },
        "test": {
          "type": "object",
          "required": ["variable"],
          "additionalProperties": false,
          "properties": {
            "variable": { "type": "string", "enum": ["hook", "subhead", "visual", "cta", "surface"], "description": "The one variable this ad changes against the control named in extends.ad_name. Appended to the ad name as _t-<variable>." },
            "recipe": { "type": "string", "description": "recipe.json the variant was built from (scripts/recipe_variants.py), relative to ads.json." }
          }
        },
        "claims": { "type": "array", "items": { "$ref": "#/$defs/claim" } },
        "media": { "type": "array", "maxItems": 2, "items": { "$ref": "#/$defs/media" } },
        "logo": { "type": "boolean", "description": "Show the brand logo (default true)." },
        "meta_ad": { "$ref": "#/$defs/meta_ad" },
        "notes": { "type": "string" }
      }
    }
  }
}
