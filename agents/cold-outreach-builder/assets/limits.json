{
  "_comment": "Single source of the mechanical limits applied by scripts/lint_outreach.py. Every value here is a stack default chosen for short plain-text cold messages, not a benchmark from a study: change them per project in <project>/cold-outreach-builder/limits.json (same shape, keys merged over this file), never in the copy guidance. Word counts exclude the signature line.",
  "schema_version": "1.0",
  "channels": {
    "email": {
      "subject_required_on_step_1": true,
      "subject_max_chars": 50,
      "words": {
        "step_1": { "warn": 80, "max": 90 },
        "follow_up": { "warn": 70, "max": 90 }
      },
      "max_chars": null,
      "links": { "step_1_max": 0, "follow_up_max": 1 },
      "signature_required": true,
      "emoji": "BLOCK"
    },
    "linkedin": {
      "subject_required_on_step_1": false,
      "subject_max_chars": null,
      "words": {
        "step_1": { "warn": 35, "max": 45 },
        "follow_up": { "warn": 55, "max": 60 }
      },
      "max_chars": { "step_1": 200 },
      "links": { "step_1_max": 0, "follow_up_max": 1 },
      "signature_required": false,
      "emoji": "WARN"
    }
  },
  "hooks": {
    "_comment": "Hooks are compared between prospects on word 3-grams after masking each row's own name and company. Jaccard similarity at or above block is a BLOCK, at or above warn a WARN.",
    "shingle_size": 3,
    "similarity_block": 0.6,
    "similarity_warn": 0.4,
    "require_sourced_fact_in_step_1": true
  },
  "tokens": {
    "signature_token": "{{sender_first_name}}",
    "allowed_unfilled": ["sender_first_name"]
  },
  "numbers": {
    "_comment": "A number in a message body must appear in the prospect's verified facts, in positioning.proof of project-context, or match one of these patterns (durations, dates, times). Anything else is an unsourced number.",
    "allow_patterns": [
      "\\b\\d{1,3}\\s?(?:-\\s?)?(?:min|mins|minute|minutes|mn|h|hr|hrs|hour|hours|heure|heures|day|days|jour|jours|week|weeks|semaine|semaines|month|months|mois)\\b",
      "\\b(?:19|20)\\d{2}\\b",
      "\\b\\d{1,2}[/.]\\d{1,2}(?:[/.]\\d{2,4})?\\b",
      "\\b\\d{1,2}(?::\\d{2}|h\\d{0,2})\\b",
      "\\b\\d{1,2}(?:st|nd|rd|th|er|e)?\\s+(?:jan|feb|mar|apr|may|jun|jul|aug|sep|sept|oct|nov|dec|janv|févr|fevr|mars|avr|mai|juin|juil|août|aout|déc)[a-zéû]*\\b",
      "\\b(?:jan|feb|mar|apr|may|jun|jul|aug|sep|sept|oct|nov|dec)[a-z]*\\.?\\s+\\d{1,2}\\b"
    ]
  },
  "links": {
    "shorteners": ["bit.ly", "tinyurl.com", "goo.gl", "t.co", "ow.ly", "buff.ly", "rebrand.ly", "cutt.ly", "is.gd", "lnkd.in", "shorturl.at", "tiny.cc"]
  },
  "state": {
    "recontact_after_days": 180
  }
}
