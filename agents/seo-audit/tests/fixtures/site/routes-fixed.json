      "status": 200,
      "file": "blog.html"
    },
    "/blog/first-pitch/": {
      "status": 200,
      "file": "first-pitch-fixed.html"
    },
    "/blog/pitch-deck-mistakes/": {
      "status": 200,
      "file": "pitch-deck-mistakes.html"
    },
    "/blog/pitch-deck-mistakes": {
      "status": 301,
      "headers": {
        "Location": "/blog/pitch-deck-mistakes/"
      }
    },
