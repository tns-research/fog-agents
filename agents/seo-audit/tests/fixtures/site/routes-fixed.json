      "status": 200,
      "file": "orphan-guide.html"
    },
    "/blog/first-pitch": {
      "status": 301,
      "headers": {
        "Location": "/blog/first-pitch/"
      }
    },
    "/program": {
      "status": 301,
      "headers": {
        "Location": "/program/"
      }
    },
    "/old-program/": {
      "status": 301,
      "headers": {
        "Location": "/program/"
      }
    },
    "/events/": {
      "status": 200,
      "file": "events.html"
    },
    "/apply/": {
      "status": 200,
      "file": "apply.html"
    },
    "/legal/": {
      "status": 200,
      "file": "legal.html",
      "headers": {
        "X-Robots-Tag": "noindex"
      }
    },
    "/private/": {
      "status": 200,
      "file": "legal.html"
    },
    "/robots.txt": {
      "status": 200,
      "file": "robots-fixed.txt",
      "headers": {
        "Content-Type": "text/plain; charset=utf-8"
      }
    },
    "/sitemap.xml": {
      "status": 200,
      "file": "sitemap.xml",
      "headers": {
        "Content-Type": "application/xml"
      }
    }
