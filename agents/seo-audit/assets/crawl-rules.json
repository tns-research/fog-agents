    "canonical-target-not-200": "error",
    "noindex": "info",
    "title-missing": "error",
    "title-multiple": "warning",
    "title-duplicate": "warning",
    "title-long": "info",
    "description-missing": "warning",
    "description-duplicate": "warning",
    "description-length": "info",
    "h1-missing": "warning",
    "h1-multiple": "info",
    "og-url-missing": "info",
    "og-url-mismatch": "warning",
