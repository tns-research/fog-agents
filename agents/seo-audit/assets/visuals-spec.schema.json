{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "visuals-spec.json",
  "description": "Article visuals written by the model for scripts/article_visuals.py: one cover and the body visuals of one article. The script typesets this text and never writes any. The validator subset has no oneOf, so data lists the keys of every kind and article_visuals.py checks the keys each kind needs (see the kinds table in skills/rendering-article-visuals/SKILL.md). Validate with: python3 ../../shared/scripts/validate_json.py assets/visuals-spec.schema.json <visuals-spec.json>",
  "type": "object",
  "required": ["cover", "body"],
  "additionalProperties": false,
  "properties": {
    "schema_version": { "type": "string", "enum": ["1.0"] },
    "lang": {
      "type": "string",
      "pattern": "^[a-z]{2}(-[A-Za-z]{2})?$",
      "description": "Language of the article: labels the script prints itself (Source, Yes, No) and typography rules (French spaces). Default en."
    },
    "logo": {
      "type": "boolean",
      "description": "Brand logo in the footer of body visuals and on the cover. Default true."
    },
    "cover": {
      "type": "object",
      "required": ["kind", "title", "alt"],
      "additionalProperties": false,
      "properties": {
        "kind": { "const": "cover" },
        "title": { "type": "string", "minLength": 1, "maxLength": 110 },
        "kicker": { "type": "string", "maxLength": 48, "description": "Short line above the title: the topic or the category." },
        "alt": { "type": "string", "minLength": 1, "maxLength": 250 }
      }
    },
    "body": {
      "type": "array",
      "minItems": 0,
      "maxItems": 8,
      "items": { "$ref": "#/$defs/visual" }
    }
  },
  "$defs": {
    "text": { "type": "string", "minLength": 1 },
    "visual": {
      "type": "object",
      "required": ["id", "kind", "title", "after_h2", "alt", "data"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,31}$", "description": "File stem: v1 gives visuals/v1.png." },
        "kind": { "type": "string", "enum": ["comparison", "steps", "checklist", "stat", "timeline", "decision"] },
        "title": { "type": "string", "minLength": 1, "maxLength": 90 },
        "after_h2": { "type": "string", "minLength": 1, "description": "Exact text of the H2 the image goes under." },
        "alt": { "type": "string", "minLength": 1, "maxLength": 250 },
        "source": { "type": "string", "minLength": 1, "maxLength": 140, "description": "Footer source line (required per figure in stat, optional elsewhere)." },
        "data": { "$ref": "#/$defs/data" }
      }
    },
    "data": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "corner": { "type": "string", "maxLength": 28, "description": "comparison: header of the row-label column." },
        "columns": { "type": "array", "minItems": 2, "maxItems": 4, "items": { "type": "string", "minLength": 1, "maxLength": 28 } },
        "rows": {
          "type": "array",
          "minItems": 2,
          "maxItems": 8,
          "items": {
            "type": "object",
            "required": ["label", "cells"],
            "additionalProperties": false,
            "properties": {
              "label": { "type": "string", "minLength": 1, "maxLength": 48 },
              "cells": {
                "type": "array",
                "minItems": 2,
                "maxItems": 4,
                "items": { "type": "string", "minLength": 1, "maxLength": 60, "description": "Text, or yes / no / partial (drawn as icons), optionally followed by ': note'." }
              }
            }
          }
        },
        "highlight": { "type": "integer", "minimum": 0, "maximum": 3, "description": "comparison: index of the column to emphasise." },
        "steps": {
          "type": "array",
          "minItems": 3,
          "maxItems": 7,
          "items": {
            "type": "object",
            "required": ["title"],
            "additionalProperties": false,
            "properties": {
              "title": { "type": "string", "minLength": 1, "maxLength": 60 },
              "text": { "type": "string", "maxLength": 220 }
            }
          }
        },
        "layout": { "type": "string", "enum": ["auto", "vertical", "horizontal", "one-column", "two-columns"], "description": "steps: auto, vertical, horizontal; checklist: auto, one-column, two-columns." },
        "items": {
          "type": "array",
          "minItems": 4,
          "maxItems": 10,
          "items": {
            "type": "object",
            "required": ["text"],
            "additionalProperties": false,
            "properties": {
              "text": { "type": "string", "minLength": 1, "maxLength": 120 },
              "state": { "type": "string", "enum": ["check", "warn", "cross"], "description": "Default check." }
            }
          }
        },
        "stats": {
          "type": "array",
          "minItems": 1,
          "maxItems": 3,
          "items": {
            "type": "object",
            "required": ["value", "label", "source"],
            "additionalProperties": false,
            "properties": {
              "value": { "type": "string", "minLength": 1, "maxLength": 10 },
              "label": { "type": "string", "minLength": 1, "maxLength": 90 },
              "source": { "type": "string", "minLength": 1, "maxLength": 120, "description": "Who published the figure, as cited in the article or in positioning.proof." },
              "source_url": { "type": "string", "pattern": "^https?://" }
            }
          }
        },
        "events": {
          "type": "array",
          "minItems": 3,
          "maxItems": 8,
          "items": {
            "type": "object",
            "required": ["date", "title"],
            "additionalProperties": false,
            "properties": {
              "date": { "type": "string", "minLength": 1, "maxLength": 16 },
              "title": { "type": "string", "minLength": 1, "maxLength": 60 },
              "text": { "type": "string", "maxLength": 200 }
            }
          }
        },
        "question": { "type": "string", "minLength": 1, "maxLength": 90, "description": "decision: root question." },
        "yes": { "$ref": "#/$defs/branch" },
        "no": { "$ref": "#/$defs/branch" },
        "yes_label": { "type": "string", "minLength": 1, "maxLength": 12 },
        "no_label": { "type": "string", "minLength": 1, "maxLength": 12 }
      }
    },
    "branch": {
      "type": "object",
      "additionalProperties": false,
      "description": "decision: either an outcome, or a second question with two outcomes (two levels at most).",
      "properties": {
        "outcome": { "type": "string", "minLength": 1, "maxLength": 70 },
        "question": { "type": "string", "minLength": 1, "maxLength": 90 },
        "yes": { "$ref": "#/$defs/leaf" },
        "no": { "$ref": "#/$defs/leaf" }
      }
    },
    "leaf": {
      "type": "object",
      "required": ["outcome"],
      "additionalProperties": false,
      "properties": {
        "outcome": { "type": "string", "minLength": 1, "maxLength": 70 }
      }
    }
  }
}
