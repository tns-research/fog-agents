{"url": "https://swanbase.example/blog/first-pitch/", "final_url": "https://swanbase.example/blog/first-pitch/", "status": 200, "redirect_chain": [], "content_type": "text/html; charset=utf-8", "x_robots_tag": null, "error": null, "blocked_by_robots": false, "source": "sitemap", "in_sitemap": true, "depth": 1, "inlinks": 2, "lang": "en", "title": "Your first pitch: what to expect | swanbase", "title_length": 43, "meta_description": "What happens when you pitch for the first time at swanbase: five minutes, questions from the room, and written feedback the same evening.", "description_length": 137, "h1": ["Your first pitch: what to expect"], "h1_count": 1, "h2": [], "h3": [], "canonical": "https://swanbase.example/blog/first-pitch/", "canonical_status": "self", "meta_robots": null, "indexable": true, "hreflang": [], "og_url": "https://www.swanbase.example/blog/first-pitch/", "og_title": null, "word_count": 78, "internal_links": ["https://swanbase.example/", "https://swanbase.example/blog/pitch-deck-mistakes/"], "internal_links_count": 2, "external_links_count": 0, "internal_anchors": [{"url": "https://swanbase.example/", "text": "swanbase", "zone": "chrome"}, {"url": "https://swanbase.example/blog/pitch-deck-mistakes/", "text": "mistakes we see every week", "zone": "body"}], "body_inlinks": 2, "text_blocks": [{"text": "You get five minutes. The room listens, then asks questions for as long as the questions are useful. Nobody grades the deck: the point is to hear which parts of the story land and which ones raise doubts.", "links": []}, {"text": "The same evening, you get written feedback from the people in the room. Most founders rewrite their opening after the first session. Read the mistakes we see every week before you come. {{ cta_label }}", "links": [[142, 168]]}], "jsonld": [{"types": ["BlogPosting", "Article", "BreadcrumbList"], "valid": true, "error": null}], "jsonld_types": ["Article", "BlogPosting", "BreadcrumbList"], "images": 0, "images_no_alt": 0, "images