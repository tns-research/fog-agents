ogram", "text": "program", "zone": "body"}, {"url": "https://swanbase.example/about/", "text": "team page", "zone": "body"}, {"url": "https://swanbase.example/private/", "text": "members area", "zone": "body"}, {"url": "https://swanbase.example/legal/", "text": "Legal", "zone": "chrome"}], "body_inlinks": 1, "text_blocks": [{"text": "swanbase helps first-time founders go from an idea to a first round. Founders pitch every week in front of peers, work from a venue in central Paris and keep the program for as long as they need it. Entry is free and on application.", "links": []}, {"text": "Read how a first pitch goes, see the program, or read the team page. Our members area is private.", "links": [[11, 22], [37, 44], [58, 67], [73, 85]]}], "jsonld": [{"types": ["Organization"], "valid": true, "error": null}], "jsonld_types": ["Organization"], "images": 0, "images_no_alt": 0, "images_no_alt_src": [], "external_links": ["https://www.linkedin.com/company/example"], "eeat_raw": {"meta": {}, "elements": [], "rel_author": [], "itemprops": [], "itemtypes": [], "citations": [], "headings": [], "date_phrases": [], "jsonld_entities": [{"path": "jsonld[0]", "types": ["Organization"], "name": "swanbase"}]}, "issues": ["hreflang-not-reciprocal", "broken-internal-link"], "title_count": 1, "canonical_count": 1}
{"url": "https://swanbase.example/fr/", "final_url": "https://swanbase.example/fr/", "status": 200, "redirect_chain": [], "content_type": "text/html; charset=utf-8", "x_robots_tag": null, "error": null, "blocked_by_robots": false, "source": "sitemap", "in_sitemap": true, "depth": null, "inlinks": 0, "lang": "fr", "title": "swanbase | Accélérateur pré-seed à Paris", "title_length": 40, "meta_description": "swanbase est un accélérateur pré-seed à Paris pour les fondateurs qui lancent leur première startup : pitch chaque semaine et un programme à l'année.", "description_length": 149, "h1": ["Un accélérateur pré-seed à Paris"], "h1_count": 1, "h2": [], "h3": [], "canonical": "https://swanbase.example/fr/", "canonical_status": "self", "meta_robots": null, "indexable": true, "hreflang": [{"lang": "fr", "href": "https://swanbase.example/fr/"}], "og_url": "https://swanbase.example/fr/", "og_title": null, "word_count": 59, "internal_links": ["https://swanbase.example/"], "internal_links_count": 1, "external_links_count": 0, "internal_anchors": [{"url": "https://swanbase.example/", "text": "English", "zone": "body"}], "body_inlinks": 0, "text_blocks": [{"text": "swanbase accompagne les fondateurs de la première idée à la première levée, avec un pitch chaque semaine et un lieu au centre de Paris. L'entrée est gratuite, sur candidature, et le programme dure aussi longtemps que nécessaire. Chaque semaine, les fondateurs présentent leur projet devant leurs pairs et repartent avec des retours écrits.", "links": []}], "jsonld": [], "jsonld_types": [], "images": 0, "images_no_alt": 0, "images_no_alt_src": [], "external_links": [], "eeat_raw": {"meta": {}, "elements": [], "rel_author": [], "itemprops": [], "itemtypes": [], "citations": [], "headings": [], "date_phrases": [], "jsonld_entities": []}, "issues": ["orphan-in-sitemap"], "title_count": 1, "canonical_count": 1}
