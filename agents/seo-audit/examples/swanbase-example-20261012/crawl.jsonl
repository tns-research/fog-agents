{"url": "https://swanbase.example/blog/pitch-deck-mistakes/", "final_url": "https://swanbase.example/blog/pitch-deck-mistakes/", "status": 200, "redirect_chain": [], "content_type": "text/html; charset=utf-8", "x_robots_tag": null, "error": null, "blocked_by_robots": false, "source": "sitemap", "in_sitemap": true, "depth": 2, "inlinks": 2, "lang": "en", "title": "Your first pitch: what to expect | swanbase", "title_length": 43, "meta_description": "The pitch deck mistakes founders make at their first sessions, and how they fix them before meeting investors.", "description_length": 110, "h1": ["Pitch deck mistakes we see every week"], "h1_count": 1, "h2": [], "h3": [], "canonical": "https://swanbase.example/blog/pitch-deck-mistakes/", "canonical_status": "self", "meta_robots": null, "indexable": true, "hreflang": [], "og_url": "https://swanbase.example/blog/pitch-deck-mistakes/", "og_title": null, "word_count": 70, "internal_links": ["https://swanbase.example/blog/"], "internal_links_count": 1, "external_links_count": 0, "internal_anchors": [{"url": "https://swanbase.example/blog/", "text": "blog", "zone": "body"}], "body_inlinks": 2, "text_blocks": [{"text": "The most common one: a deck that explains the product before the problem. The second: a market slide that nobody in the room can check. The third: an ask that does not say what the money will prove.", "links": []}, {"text": "Each of them is easy to fix once someone points at it, which is what the weekly session is for. Go back to the blog.", "links": [[111, 115]]}], "jsonld": [{"types": [], "valid": false, "error": "invalid JSON at line 1"}], "jsonld_types": [], "images": 0, "images_no_alt": 0, "images_no_alt_src": [], "external_links": [], "eeat_raw": {"meta": {}, "elements": [], "rel_author": [], "itemprops": [], "itemtypes": [], "citations": [], "headings": [], "date_phrases": [], "jsonld_entities": []}, "issues": ["slash-duplicate", "jsonld-invalid", "title-duplicate", "description-duplicate"], "title_count