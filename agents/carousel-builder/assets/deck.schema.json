{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/tns-research/fog-agents/agents/carousel-builder/assets/deck.schema.json",
  "title": "carousel-builder deck spec (deck.json)",
  "description": "The only file the model writes for a carousel. scripts/build.py turns it into build/index.html; the model never edits HTML. Every number shown on a slide carries a source (block.source or a sources[] id).",
  "type": "object",
  "required": ["meta", "slides"],
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "meta": { "$ref": "#/$defs/meta" },
    "sources": {
      "type": "array",
      "description": "Source registry. Blocks point to an entry with \"source\": \"<id>\".",
      "items": { "$ref": "#/$defs/source_entry" }
    },
    "slides": {
      "type": "array",
      "minItems": 1,
      "maxItems": 20,
      "description": "3 to 20 slides: Instagram publishes 20 images per carousel at most; build.py reports anything outside it.",
      "items": { "$ref": "#/$defs/slide" }
    }
  },
  "$defs": {
    "meta": {
      "type": "object",
      "required": ["format", "direction", "language"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$", "description": "Slug used for file names." },
        "title": { "type": "string", "description": "Internal title (HTML <title>, report)." },
        "format": { "enum": ["linkedin", "instagram", "square"], "description": "linkedin and instagram = 1080x1350 (4:5), square = 1080x1080." },
        "direction": { "type": "string", "pattern": "^[a-z0-9-]+$", "description": "Folder name under directions/." },
        "language": { "type": "string", "pattern": "^[a-z]{2}(-[A-Z]{2})?$" },
        "brand": { "type": "string", "description": "Path to brand.json, relative to deck.json. CLI --brand wins." },
        "use_brand_fonts": { "type": "boolean", "description": "Override the direction default (direction.json brand.fonts)." },
        "handle": { "type": "string", "maxLength": 40, "description": "Account or site shown in the slide chrome, e.g. @acme or acme.example." },
        "page_numbers": { "type": "boolean", "description": "Folio on content slides. Off by default: a 01/08 counter on every slide reads as a generated deck." },
        "angle": { "type": "string" },
        "audience": { "type": "string" },
        "covers": { "$ref": "#/$defs/covers" },
        "captions": { "$ref": "#/$defs/captions" }
      }
    },
    "covers": {
      "type": "object",
      "description": "Input of build.py --covers: hooks x cover layouts, rendered side by side for the art-direction stop.",
      "additionalProperties": false,
      "properties": {
        "hooks": {
          "type": "array",
          "minItems": 1,
          "maxItems": 4,
          "items": {
            "type": "object",
            "required": ["title"],
            "additionalProperties": false,
            "properties": {
              "id": { "type": "string" },
              "title": { "type": "string", "minLength": 1, "maxLength": 140 },
              "accent": { "type": "string" },
              "sub": { "type": "string", "maxLength": 220 }
            }
          }
        },
        "layouts": { "type": "array", "items": { "type": "string" } }
      }
    },
    "captions": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "linkedin": { "type": "string", "description": "Post text, 3000 characters max." },
        "first_comment": { "type": "string", "description": "Link and source list for the first comment." },
        "instagram": { "type": "string", "description": "Caption, 2200 characters max, hashtags included." },
        "hashtags": { "type": "array", "items": { "type": "string", "pattern": "^#[^\\s#]+$" }, "maxItems": 10 }
      }
    },
    "source_entry": {
      "type": "object",
      "required": ["id", "label"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^[a-zA-Z0-9_-]+$" },
        "label": { "type": "string", "minLength": 1, "maxLength": 90, "description": "Printed in the slide footer, e.g. 'DocSend, mars 2026'." },
        "url": { "type": "string", "pattern": "^https?://" },
        "proof_ref": { "type": "string", "description": "Pointer into project-context, e.g. positioning.proof[2], when the claim is an approved proof without URL." },
        "accessed": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
        "note": { "type": "string" }
      }
    },
    "source": {
      "description": "A sources[] id, or an inline object.",
      "oneOf": [
        { "type": "string", "minLength": 1 },
        {
          "type": "object",
          "required": ["label"],
          "additionalProperties": false,
          "properties": {
            "label": { "type": "string", "minLength": 1, "maxLength": 90 },
            "url": { "type": "string", "pattern": "^https?://" },
            "proof_ref": { "type": "string" },
            "accessed": { "type": "string" }
          }
        }
      ]
    },
    "slide": {
      "type": "object",
      "required": ["role", "blocks"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string" },
        "role": { "enum": ["cover", "content", "cta"] },
        "layout": { "type": "string", "description": "A layout named in the direction's direction.json. Omit to let build.py pick from the blocks." },
        "surface": { "enum": ["default", "inverse", "accent"], "description": "Swap the slide to the direction's inverse or accent surface, for rhythm." },
        "tone": { "enum": ["calm", "dense"], "description": "Omit: computed from the blocks." },
        "alt": { "type": "string", "maxLength": 600, "description": "Alt text for this slide. Omit: captions.py composes one from the blocks." },
        "notes": { "type": "string", "description": "Not rendered. Why this slide exists, for the reviewer." },
        "blocks": {
          "type": "array",
          "minItems": 1,
          "maxItems": 6,
          "items": { "$ref": "#/$defs/block" }
        }
      }
    },
    "block": {
      "oneOf": [
        { "$ref": "#/$defs/b_title" },
        { "$ref": "#/$defs/b_body" },
        { "$ref": "#/$defs/b_list" },
        { "$ref": "#/$defs/b_stat" },
        { "$ref": "#/$defs/b_chart" },
        { "$ref": "#/$defs/b_photo" },
        { "$ref": "#/$defs/b_screenshot" },
        { "$ref": "#/$defs/b_quote" },
        { "$ref": "#/$defs/b_logo_row" },
        { "$ref": "#/$defs/b_visual" },
        { "$ref": "#/$defs/b_cta" }
      ]
    },
    "b_title": {
      "type": "object",
      "required": ["type", "text"],
      "additionalProperties": false,
      "properties": {
        "type": { "const": "title" },
        "text": { "type": "string", "minLength": 1, "maxLength": 240 },
        "accent": { "type": "string", "description": "Exact substring of text that carries the accent. One per title." },
        "sub": { "type": "string", "maxLength": 260, "description": "Standfirst under the title (cover) or a one-line deck." },
        "source": { "$ref": "#/$defs/source" }
      }
    },
    "b_body": {
      "type": "object",
      "required": ["type", "text"],
      "additionalProperties": false,
      "properties": {
        "type": { "const": "body" },
        "text": { "type": "string", "minLength": 1, "maxLength": 600, "description": "Paragraphs separated by a blank line." },
        "accent": { "type": "string" },
        "source": { "$ref": "#/$defs/source" }
      }
    },
    "b_list": {
      "type": "object",
      "required": ["type", "items"],
      "additionalProperties": false,
      "properties": {
        "type": { "const": "list" },
        "style": { "enum": ["numbered", "bullets", "checks", "plain"], "description": "numbered only for a real sequence." },
        "items": {
          "type": "array",
          "minItems": 1,
          "maxItems": 7,
          "items": {
            "oneOf": [
              { "type": "string", "minLength": 1, "maxLength": 160 },
              {
                "type": "object",
                "required": ["text"],
                "additionalProperties": false,
                "properties": {
                  "text": { "type": "string", "minLength": 1, "maxLength": 160 },
                  "sub": { "type": "string", "maxLength": 200 }
                }
              }
            ]
          }
        },
        "source": { "$ref": "#/$defs/source" }
      }
    },
    "b_stat": {
      "type": "object",
      "required": ["type", "value", "label", "source"],
      "additionalProperties": false,
      "properties": {
        "type": { "const": "stat" },
        "value": { "type": "string", "minLength": 1, "maxLength": 14, "description": "As printed: '58 %', '3 min 44', '64 s'." },
        "label": { "type": "string", "minLength": 1, "maxLength": 160 },
        "context": { "type": "string", "maxLength": 220 },
        "source": { "$ref": "#/$defs/source" }
      }
    },
    "b_chart": {
      "type": "object",
      "required": ["type", "kind", "title", "unit", "source"],
      "additionalProperties": false,
      "properties": {
        "type": { "const": "chart" },
        "kind": { "enum": ["bar", "line", "donut"] },
        "title": { "type": "string", "minLength": 1, "maxLength": 90, "description": "What the chart shows. The unit is appended unless already in the title." },
        "unit": { "type": "string", "minLength": 1, "maxLength": 24 },
        "data": {
          "type": "array",
          "description": "bar and donut: one entry per category.",
          "minItems": 2,
          "maxItems": 14,
          "items": {
            "type": "object",
            "required": ["label", "value"],
            "additionalProperties": false,
            "properties": {
              "label": { "type": "string", "minLength": 1, "maxLength": 40 },
              "value": { "type": "number" }
            }
          }
        },
        "x": { "type": "array", "description": "line: x labels.", "items": { "type": ["string", "number"] }, "minItems": 2, "maxItems": 24 },
        "series": {
          "type": "array",
          "description": "line: one or more series aligned on x.",
          "minItems": 1,
          "maxItems": 4,
          "items": {
            "type": "object",
            "required": ["name", "values"],
            "additionalProperties": false,
            "properties": {
              "name": { "type": "string", "minLength": 1, "maxLength": 30 },
              "values": { "type": "array", "items": { "type": ["number", "null"] } }
            }
          }
        },
        "highlight": { "type": "string", "description": "Label (bar, donut) or series name (line) that carries the message. Gets the only accent." },
        "sort": { "enum": ["none", "desc", "asc"], "description": "bar: default desc for horizontal bars (rankings), none for columns (time, steps)." },
        "orientation": { "enum": ["auto", "horizontal", "vertical"] },
        "decimals": { "type": "integer", "minimum": 0, "maximum": 3 },
        "value_suffix": { "type": "string", "maxLength": 6, "description": "Printed after each value label, e.g. ' s' or ' %'." },
        "note": { "type": "string", "maxLength": 160 },
        "source": { "$ref": "#/$defs/source" }
      }
    },
    "b_photo": {
      "type": "object",
      "required": ["type", "src", "alt"],
      "additionalProperties": false,
      "properties": {
        "type": { "const": "photo" },
        "src": { "type": "string", "minLength": 1, "description": "Path relative to deck.json, or absolute." },
        "alt": { "type": "string", "minLength": 1, "maxLength": 300 },
        "fit": { "enum": ["contain", "cover"], "description": "contain (default) never crops. cover crops and requires crop_ok." },
        "crop_ok": { "type": "boolean", "description": "Set only when the person who owns the photo accepted a crop." },
        "focus": { "type": "array", "items": { "type": "number", "minimum": 0, "maximum": 1 }, "minItems": 2, "maxItems": 2 },
        "mat": { "enum": ["blur", "paper", "ink", "none"], "description": "What fills the zone around a contained photo. Default from the direction." },
        "caption": { "type": "string", "maxLength": 160 },
        "credit": { "type": "string", "maxLength": 80 }
      }
    },
    "b_screenshot": {
      "type": "object",
      "required": ["type", "src", "alt"],
      "additionalProperties": false,
      "properties": {
        "type": { "const": "screenshot" },
        "src": { "type": "string", "minLength": 1 },
        "alt": { "type": "string", "minLength": 1, "maxLength": 300 },
        "frame": { "enum": ["browser", "plain", "phone"] },
        "url": { "type": "string", "maxLength": 80, "description": "Shown in the browser frame bar." },
        "annotations": {
          "type": "array",
          "maxItems": 4,
          "items": {
            "type": "object",
            "required": ["box", "label"],
            "additionalProperties": false,
            "properties": {
              "box": { "type": "array", "items": { "type": "number", "minimum": 0, "maximum": 1 }, "minItems": 4, "maxItems": 4, "description": "[x, y, w, h] as fractions of the image." },
              "label": { "type": "string", "minLength": 1, "maxLength": 90 }
            }
          }
        },
        "caption": { "type": "string", "maxLength": 160 }
      }
    },
    "b_quote": {
      "type": "object",
      "required": ["type", "text", "author", "source"],
      "additionalProperties": false,
      "properties": {
        "type": { "const": "quote" },
        "text": { "type": "string", "minLength": 1, "maxLength": 320, "description": "Verbatim. A translation sets translated: true." },
        "author": { "type": "string", "minLength": 1, "maxLength": 80 },
        "role": { "type": "string", "maxLength": 90 },
        "translated": { "type": "boolean" },
        "source": { "$ref": "#/$defs/source" }
      }
    },
    "b_logo_row": {
      "type": "object",
      "required": ["type", "logos"],
      "additionalProperties": false,
      "properties": {
        "type": { "const": "logo-row" },
        "label": { "type": "string", "maxLength": 80 },
        "logos": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "items": {
            "type": "object",
            "required": ["src", "name"],
            "additionalProperties": false,
            "properties": {
              "src": { "type": "string", "minLength": 1 },
              "name": { "type": "string", "minLength": 1 },
              "ink": { "type": "boolean", "description": "Force the logo to the ink colour (white wordmark on a light slide)." }
            }
          }
        },
        "source": { "$ref": "#/$defs/source" }
      }
    },
    "b_visual": {
      "type": "object",
      "required": ["type", "alt"],
      "additionalProperties": false,
      "properties": {
        "type": { "const": "visual" },
        "svg": { "type": "string", "description": "A complete <svg> element. Use class names c-ink, c-muted, c-accent, c-fill, c-paper to inherit the direction palette." },
        "file": { "type": "string", "description": "Path to an .svg file relative to deck.json." },
        "alt": { "type": "string", "minLength": 1, "maxLength": 300 },
        "caption": { "type": "string", "maxLength": 160 },
        "source": { "$ref": "#/$defs/source" }
      }
    },
    "b_cta": {
      "type": "object",
      "required": ["type", "text"],
      "additionalProperties": false,
      "properties": {
        "type": { "const": "cta" },
        "text": { "type": "string", "minLength": 1, "maxLength": 120, "description": "The action, in the imperative or as a question." },
        "url": { "type": "string", "maxLength": 80, "description": "Printed as text (links are not clickable in a carousel)." },
        "sub": { "type": "string", "maxLength": 200 }
      }
    }
  }
}
