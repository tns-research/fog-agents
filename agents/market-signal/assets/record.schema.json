{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/tns-research/fog-agents/agents/market-signal/assets/record.schema.json",
  "title": "market-signal corpus record (one line of runs/<YYYYMMDD>/corpus.jsonl)",
  "description": "Written by the collectors and import_records.py, never by the model. text is the public text converted to plain text (HTML tags and markdown link targets removed), with profile links, emails, phone numbers and @mentions replaced by placeholders and handles written in the text replaced by their pseudonym (mslib.scrub). No handle is stored: author_hash, computed on the pseudonym, counts distinct people.",
  "type": "object",
  "required": ["record_id", "source", "community", "kind", "url", "author_hash", "date", "text", "method"],
  "additionalProperties": false,
  "properties": {
    "record_id": { "type": "string", "pattern": "^[a-z]+:[^\\s]+$" },
    "source": { "type": "string", "minLength": 2 },
    "community": { "type": "string" },
    "kind": { "enum": ["post", "comment", "story", "question", "answer", "review", "article"] },
    "url": { "type": ["string", "null"], "pattern": "^https?://" },
    "author_hash": { "type": ["string", "null"], "pattern": "^[0-9a-f]{12}$" },
    "date": { "type": ["string", "null"], "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "created_at": { "type": ["string", "null"] },
    "title": { "type": ["string", "null"] },
    "text": { "type": "string" },
    "context": { "type": ["string", "null"] },
    "score": { "type": ["integer", "null"] },
    "replies": { "type": ["integer", "null"] },
    "rating": { "type": ["integer", "null"], "minimum": 1, "maximum": 5 },
    "lang": { "type": ["string", "null"] },
    "query": { "type": ["string", "null"] },
    "method": { "type": "string" },
    "fetched_at": { "type": ["string", "null"] }
  }
}
