{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/tns-research/fog-agents/agents/market-signal/assets/plan.schema.json",
  "title": "market-signal collection plan (runs/<YYYYMMDD>/plan.json)",
  "description": "Written by the model at Step 1, read by scripts/collect.py. One job per source and query. Hypotheses come from project-context icp.pains: they shape queries and are never reported as findings.",
  "type": "object",
  "required": ["schema_version", "market", "window", "jobs"],
  "additionalProperties": false,
  "properties": {
    "schema_version": { "const": "2.0" },
    "project": { "type": "string" },
    "market": { "type": "string", "minLength": 3 },
    "language": { "type": "string", "pattern": "^[a-z]{2}(,[a-z]{2})*$|^both$" },
    "geography": { "type": "string" },
    "as_of": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "window": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "since": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
        "until": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
        "recency_days": { "type": "integer", "minimum": 1, "maximum": 3650 }
      }
    },
    "caps": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "records_per_job": { "type": "integer", "minimum": 1, "maximum": 1000 },
        "pages_per_job": { "type": "integer", "minimum": 1, "maximum": 20 }
      }
    },
    "hypotheses": { "type": "array", "items": { "type": "string" } },
    "jobs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "source", "args"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{1,59}$" },
          "source": { "enum": ["hn", "reddit", "stackexchange", "discourse", "appstore", "import"] },
          "why": { "type": "string" },
          "limit": { "type": "integer", "minimum": 1, "maximum": 1000 },
          "max_pages": { "type": "integer", "minimum": 1, "maximum": 20 },
          "args": { "type": "object" }
        }
      }
    }
  }
}
